# Copy to .env.local and restart `npm run dev`.

# Required for live answers. Without it the app runs in demo mode
# (replies are built locally from the sample dataset, no model involved).
# Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: sent to OpenRouter as the HTTP-Referer for app attribution.
# OPENROUTER_SITE_URL=http://localhost:3000

# Optional: point at an OpenRouter-compatible proxy or a local mock.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Shared workspace. The one-time code the Director types to create the first account.
# Required on the school's server before anyone can set it up. Pick something long.
# MACS_SETUP_CODE=

# Optional: where accounts and shared data are saved. Defaults to ./data. Back it up.
# MACS_DATA_DIR=

# This computer only: skip the passcode and sign in as the Director when the app is opened
# from this computer's own address. Never on the shared server (start:server refuses it).
# MACS_NO_SIGNIN=1
# MACS_LOCAL_NAME=Director
